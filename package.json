{
  "name": "helixsr-decky-armada",
  "version": "0.3.2",
  "description": "V762 Snapdragon HelixSR manager for Armada Decky Loader",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "rollup -c",
    "typecheck": "tsc --noEmit",
    "test:frontend": "node --experimental-strip-types --test tests/test_frontend.mjs",
    "test:armada": "node --experimental-strip-types --loader ./tests/armada-loader.mjs --test tests/test_armada_launch.mjs tests/test_armada_view.mjs tests/test_armada_client.mjs tests/test_armada_read_rpc.mjs"
  },
  "devDependencies": {
    "@decky/ui": "4.11.0",
    "@rollup/plugin-commonjs": "26.0.1",
    "@rollup/plugin-node-resolve": "15.2.3",
    "@rollup/plugin-replace": "5.0.7",
    "@rollup/plugin-typescript": "11.1.6",
    "rollup-plugin-external-globals": "0.11.0",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "rollup": "4.64.5",
    "typescript": "5.6.2"
  },
  "dependencies": {
    "@decky/api": "1.1.3",
    "react-icons": "5.3.0",
    "tslib": "2.7.0"
  }
}
